# Copia este archivo como .env y cambia las contraseñas.
# Usa solo letras y números en las contraseñas (sin $ # : { espacios).
# El archivo .env NO se sube a git.

# Base de datos
DB_NAME=mechanical_bull
DB_USER=mb_user
DB_PASSWORD=CambiaEstaClave2026
DB_ROOT_PASSWORD=CambiaEstaClaveRoot2026

# Puertos en tu servidor
WP_PORT=8080
PMA_PORT=8081
MAILPIT_PORT=8025

# Dirección del sitio. Si entras desde otra computadora de la red usa la IP del servidor,
# por ejemplo: SITE_URL=http://192.168.1.50:8080
SITE_URL=http://localhost:8080
SITE_TITLE="Mechanical Bull"

# Usuario administrador (dueño). No uses "admin" como usuario.
ADMIN_USER=mb_dueno
ADMIN_PASSWORD=CambiaEstaClaveAdmin2026
ADMIN_EMAIL=admin@mechanicalbull.local

# 1 = crea 8 productos de ejemplo para ver la tienda funcionando. 0 = no crearlos.
DEMO=1

# ------------------------------------------------------------------
# SOLO EN EL SERVIDOR (VPS). En tu computadora deja esto comentado.
# ------------------------------------------------------------------
# Activa la configuración de producción (HTTPS, sin Mailpit, phpMyAdmin cerrado):
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
#
# Tu dominio, sin https:// ni www (el DNS debe apuntar a la IP del VPS):
# DOMAIN=mechanicalbull.com
# Y cambia arriba: SITE_URL=https://mechanicalbull.com   y   DEMO=0
#
# Correo real (Brevo, Resend, Gmail, etc.) para que los pedidos lleguen a los clientes:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=tu-usuario-smtp
# SMTP_PASSWORD=tu-clave-smtp
# SMTP_FROM=tienda@mechanicalbull.com
